{
  "id": "/",
  "name": "Projectionist",
  "short_name": "Projectionist",
  "description": "Your household's private movie and TV companion.",
  "start_url": "/explore",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0c0d11",
  "theme_color": "#0c0d11",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Search",
      "short_name": "Search",
      "url": "/search",
      "description": "Find a title in the library"
    },
    {
      "name": "Explore",
      "short_name": "Explore",
      "url": "/explore",
      "description": "See what's on"
    }
  ]
}
