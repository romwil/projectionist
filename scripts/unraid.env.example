# Optional seed / override env for Projectionist on Unraid (used by rollout.sh).
# Copy to /mnt/user/appdata/projectionist/.env only if you want env-based seeds
# (most config lives in ./config/settings.json). Do not commit real secrets.
#
# Canonical in repo: scripts/unraid.env.example
#   cp scripts/unraid.env.example /mnt/user/appdata/projectionist/.env.example

# Image tag / host port used by rollout.sh (and optional docker-compose.yml)
# IMAGE_TAG=latest
# HOST_PORT=8788
# Lobby theater (LAN lightbox). Do not publish via public reverse proxy.
# THEATER_HOST_PORT=8791
# TZ=America/New_York

# Optional connection seeds (empty = use settings.json / Admin UI)
PLEX_URL=
PLEX_TOKEN=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
TMDB_API_KEY=
FANART_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Identify (ACRCloud) — optional show-level audio. App accepts ACRCLOUD_* or PROJECTIONIST_ACRCLOUD_*.
# ACRCLOUD_HOST=
# ACRCLOUD_ACCESS_KEY=
# ACRCLOUD_ACCESS_SECRET=
# PROJECTIONIST_ACRCLOUD_HOST=
# PROJECTIONIST_ACRCLOUD_ACCESS_KEY=
# PROJECTIONIST_ACRCLOUD_ACCESS_SECRET=

# Episode Investigate OpenSubtitles hash lane (prefer PROJECTIONIST_*).
# PROJECTIONIST_OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_API_KEY=

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional secrets (auto-generated under ./config if unset). Prefer PROJECTIONIST_*.
# CURATORX_* aliases still work in-app during the compatibility window.
# PROJECTIONIST_SESSION_SECRET=
# PROJECTIONIST_WEBHOOK_SECRET=
# PROJECTIONIST_MCP_API_KEY=
# PROJECTIONIST_MCP_FULL_API_KEY=

# PROJECTIONIST_LOG_LEVEL=INFO

# TV / movie libraries — read-write binds (Investigate Apply renames episode files).
# Host paths default to Automat. Container sees /tv and /movies plus the same host path.
PROJECTIONIST_TV_MEDIA=/mnt/user/data/media/tv
PROJECTIONIST_MOVIE_MEDIA=/mnt/user/data/media/movies

# Live plays from Projectionist's lineup. No broadcast container or tuner URL.
