# Optional seed / override env for Projectionist on Unraid (used by rollout.sh).
# Copy to /mnt/user/appdata/projectionist/.env only if you want env-based seeds
# (most config lives in ./config/settings.json). Do not commit real secrets.
#
# Canonical in repo: scripts/unraid.env.example
#   cp scripts/unraid.env.example /mnt/user/appdata/projectionist/.env.example

# Image tag / host port used by rollout.sh (and optional docker-compose.yml)
# IMAGE_TAG=latest
# HOST_PORT=8788
# Lobby theater (LAN lightbox). Do not publish via public reverse proxy.
# THEATER_HOST_PORT=8791
# TZ=America/New_York

# Optional connection seeds (empty = use settings.json / Admin UI)
PLEX_URL=
PLEX_TOKEN=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
TMDB_API_KEY=
FANART_API_KEY=
TAUTULLI_URL=
TAUTULLI_API_KEY=

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional secrets (auto-generated under ./config if unset). Prefer PROJECTIONIST_*.
# CURATORX_* aliases still work in-app during the compatibility window.
# PROJECTIONIST_SESSION_SECRET=
# PROJECTIONIST_WEBHOOK_SECRET=
# PROJECTIONIST_MCP_API_KEY=
# PROJECTIONIST_MCP_FULL_API_KEY=

# PROJECTIONIST_LOG_LEVEL=INFO

# Optional — Live Channels managed Tunarr (root-equivalent). Off by default.
# MOUNT_DOCKER_SOCK=1
# DOCKER_SOCK=/var/run/docker.sock
# Host path of the config volume (required for managed Tunarr binds via docker.sock):
# PROJECTIONIST_HOST_DATA_DIR=/mnt/user/appdata/projectionist/config
# Media library bind so Tunarr can read the same paths Plex reports (cold Live TV tunes):
# PROJECTIONIST_TUNARR_MEDIA_BINDS=/mnt/user/data/media:/data/media:ro
# Optional continuity filler folders (bumpers/trailers) — comma-separated host paths or binds:
# PROJECTIONIST_TUNARR_FILLER_BINDS=/mnt/user/media/bumpers,/mnt/user/media/trailers
# PROJECTIONIST_HOST_IP=10.10.1.202
